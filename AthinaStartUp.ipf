#pragma TextEncoding="UTF-8"
#pragma rtGlobals=3
#pragma IgorVersion=9.0

//******************************************************************************
//	Start athina
//******************************************************************************
Function ATH_AthinaLauncher()
	if(!strlen(FunctionList("CreateDataFolderGetDFREF",";","KIND:18,WIN:ATH_DFR.ipf")))
		Execute/P "INSERTINCLUDE \"ATH_Func\""
		Execute/P "INSERTINCLUDE \"ATH_CalcPad\""		
		Execute/P "INSERTINCLUDE \"ATH_FuncFit\""
		Execute/P "INSERTINCLUDE \"ATH_Magnetism\""
		Execute/P "INSERTINCLUDE \"ATH_Transform\""
		Execute/P "INSERTINCLUDE \"ATH_XPSBackgroundRemoval\""
		Execute/P "INSERTINCLUDE \"ATH_Dialog\""
		Execute/P "INSERTINCLUDE \"ATH_Launchers\""
		Execute/P "INSERTINCLUDE \"ATH_Menus\""
		Execute/P "INSERTINCLUDE \"ATH_Beamtime\""
		Execute/P "INSERTINCLUDE \"ATH_LoadHDF5\""
		Execute/P "INSERTINCLUDE \"ATH_LoadImg\""
		Execute/P "INSERTINCLUDE \"ATH_LoadUview\""
		Execute/P "INSERTINCLUDE \"ATH_Cursors\""
		Execute/P "INSERTINCLUDE \"ATH_Display\""
		Execute/P "INSERTINCLUDE \"ATH_Draw\""
		Execute/P "INSERTINCLUDE \"ATH_Graph\""
		Execute/P "INSERTINCLUDE \"ATH_Marquee\""
		Execute/P "INSERTINCLUDE \"ATH_Range\""
		Execute/P "INSERTINCLUDE \"ATH_Traces\""
		Execute/P "INSERTINCLUDE \"ATH_Windows\""
		Execute/P "INSERTINCLUDE \"ATH_ImageAlign\""
		Execute/P "INSERTINCLUDE \"ATH_ImageOp\""
		Execute/P "INSERTINCLUDE \"ATH_iBackground\""
		Execute/P "INSERTINCLUDE \"ATH_iDriftCorrection\""
		Execute/P "INSERTINCLUDE \"ATH_iImageOps\""
		Execute/P "INSERTINCLUDE \"ATH_iImageRotation\""
		Execute/P "INSERTINCLUDE \"ATH_iXMCD\""
		Execute/P "INSERTINCLUDE \"ATH_iXPS\""
		Execute/P "INSERTINCLUDE \"ATH_LineProfile\""
		Execute/P "INSERTINCLUDE \"ATH_PlaneZProfile\""
		Execute/P "INSERTINCLUDE \"ATH_ZProfile\""
		Execute/P "INSERTINCLUDE \"ATH_XPSData\""
		Execute/P "INSERTINCLUDE \"ATH_DFR\""
		Execute/P "INSERTINCLUDE \"ATH_Execute\""
		Execute/P "INSERTINCLUDE \"ATH_Geometry\""
		Execute/P "INSERTINCLUDE \"ATH_IgorHook\""
		Execute/P "INSERTINCLUDE \"ATH_Numeric\""
		Execute/P "INSERTINCLUDE \"ATH_Spaces\""
		Execute/P "INSERTINCLUDE \"ATH_String\""
		Execute/P "INSERTINCLUDE \"ATH_TextWaves\""
		Execute/P "INSERTINCLUDE \"ATH_WaveOp\""
		Execute/P "INSERTINCLUDE \"ATH_Export\""
//		Execute/P "INSERTINCLUDE \"ATH_Warp\""		
		Execute/P "INSERTINCLUDE \"IE_Baselines\""
		Execute/P "INSERTINCLUDE \"IE_FastFitting\""								
		Execute/P "COMPILEPROCEDURES "
	else
		Execute/P "DELETEINCLUDE \"ATH_Func\""
		Execute/P "DELETEINCLUDE \"ATH_CalcPad\""		
		Execute/P "DELETEINCLUDE \"ATH_FuncFit\""
		Execute/P "DELETEINCLUDE \"ATH_Magnetism\""
		Execute/P "DELETEINCLUDE \"ATH_Transform\""
		Execute/P "DELETEINCLUDE \"ATH_XPSBackgroundRemoval\""
		Execute/P "DELETEINCLUDE \"ATH_Dialog\""
		Execute/P "DELETEINCLUDE \"ATH_Launchers\""
		Execute/P "DELETEINCLUDE \"ATH_Menus\""
		Execute/P "DELETEINCLUDE \"ATH_Beamtime\""
		Execute/P "DELETEINCLUDE \"ATH_LoadHDF5\""
		Execute/P "DELETEINCLUDE \"ATH_LoadImg\""
		Execute/P "DELETEINCLUDE \"ATH_LoadUview\""
		Execute/P "DELETEINCLUDE \"ATH_Cursors\""
		Execute/P "DELETEINCLUDE \"ATH_Display\""
		Execute/P "DELETEINCLUDE \"ATH_Draw\""
		Execute/P "DELETEINCLUDE \"ATH_Graph\""
		Execute/P "DELETEINCLUDE \"ATH_Marquee\""
		Execute/P "DELETEINCLUDE \"ATH_Range\""
		Execute/P "DELETEINCLUDE \"ATH_Traces\""
		Execute/P "DELETEINCLUDE \"ATH_Windows\""
		Execute/P "DELETEINCLUDE \"ATH_ImageAlign\""
		Execute/P "DELETEINCLUDE \"ATH_ImageOp\""
		Execute/P "DELETEINCLUDE \"ATH_iBackground\""
		Execute/P "DELETEINCLUDE \"ATH_iDriftCorrection\""
		Execute/P "DELETEINCLUDE \"ATH_iImageOps\""
		Execute/P "DELETEINCLUDE \"ATH_iImageRotation\""
		Execute/P "DELETEINCLUDE \"ATH_iXMCD\""
		Execute/P "DELETEINCLUDE \"ATH_iXPS\""
		Execute/P "DELETEINCLUDE \"ATH_LineProfile\""
		Execute/P "DELETEINCLUDE \"ATH_PlaneZProfile\""
		Execute/P "DELETEINCLUDE \"ATH_ZProfile\""
		Execute/P "DELETEINCLUDE \"ATH_XPSData\""
		Execute/P "DELETEINCLUDE \"ATH_DFR\""
		Execute/P "DELETEINCLUDE \"ATH_Execute\""
		Execute/P "DELETEINCLUDE \"ATH_Geometry\""
		Execute/P "DELETEINCLUDE \"ATH_IgorHook\""
		Execute/P "DELETEINCLUDE \"ATH_Numeric\""
		Execute/P "DELETEINCLUDE \"ATH_Spaces\""
		Execute/P "DELETEINCLUDE \"ATH_String\""
		Execute/P "DELETEINCLUDE \"ATH_TextWaves\""
		Execute/P "DELETEINCLUDE \"ATH_WaveOp\""
		Execute/P "DELETEINCLUDE \"ATH_Export\""
//		Execute/P "DELETEINCLUDE \"ATH_Warp\""		
		Execute/P "DELETEINCLUDE \"IE_Baselines\""
		Execute/P "DELETEINCLUDE \"IE_FastFitting\""								
		Execute/P "COMPILEPROCEDURES "
	endif
	return 0
End

//******************************************************************************
//	Menu item in MACROS
//******************************************************************************
Menu "Macros", dynamic
	//	Nothing is displayed after athina is started
	SelectString(strlen(FunctionList("CreateDataFolderGetDFREF",";","KIND:18,WIN:ATH_DFR.ipf")), "Launch athina", "Unload athina"), /Q, ATH_AthinaLauncher()
End
